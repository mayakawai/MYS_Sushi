<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna kartu putih -->
    <solid android:color="#FFFFFF" />

    <!-- Sudut kartu membulat -->
    <corners android:radius="24dp" />

    <!-- Garis tipis ungu transparan -->
    <stroke
        android:width="1dp"
        android:color="#E8E2FF" />

    <!-- Ruang bagian dalam kartu -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />

</shape>
