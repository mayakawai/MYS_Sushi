<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FC">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:title="SIGAP"
        app:titleTextColor="#29234F" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/bg_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo SIGAP" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo, Maya 👋"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#29234F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sistem Sarana dan Prasarana"
                        android:textSize="12sp"
                        android:textColor="#625B78" />

                </LinearLayout>
            </LinearLayout>

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_login_card"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bersama menjaga"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#29234F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sarana dan prasarana"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#6254D9" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Pantau dan kelola fasilitas dengan lebih mudah melalui SIGAP."
                    android:textSize="12sp"
                    android:textColor="#625B78"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- STATISTIK -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Ringkasan Sarpras"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#29234F" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <!-- TOTAL SARPRAS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_login_card"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL SARPRAS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#625B78" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="128"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#6254D9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Sarpras"
                        android:textSize="11sp"
                        android:textColor="#625B78" />

                </LinearLayout>

                <!-- PEMINJAMAN AKTIF -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_login_card"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATUS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#625B78" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="18"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#21845F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peminjaman Aktif"
                        android:textSize="11sp"
                        android:textColor="#625B78" />

                </LinearLayout>
            </LinearLayout>

            <!-- MENU UTAMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Menu Utama"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#29234F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pilih layanan yang ingin kamu akses."
                android:textSize="12sp"
                android:textColor="#625B78" />

            <Button
                android:id="@+id/btnSarpras"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="17dp"
                android:backgroundTint="#6254D9"
                android:text="Kelola Sarpras"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnMonitoring"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="11dp"
                android:backgroundTint="#6254D9"
                android:text="Monitoring Sarpras"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPeminjaman"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="11dp"
                android:backgroundTint="#6254D9"
                android:text="Lihat Peminjaman"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="SIGAP • Mudah, Cepat, Terintegrasi"
                android:textSize="10sp"
                android:textColor="#625B78" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
