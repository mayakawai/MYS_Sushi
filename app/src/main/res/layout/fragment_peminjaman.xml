<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:titleTextColor="#242044"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Peminjaman"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#242044"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Riwayat penggunaan sarana dan prasarana"
                android:textSize="12sp"
                android:textColor="#777777"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="💻"
                    android:textSize="22sp"
                    android:background="#EFEDFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laptop TF-04"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#242044"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2 Oktober 2026"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selesai"
                    android:textSize="11sp"
                    android:textColor="#28A745"
                    android:padding="8dp"
                    android:background="#E8F7EC"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="📽️"
                    android:textSize="22sp"
                    android:background="#EFEDFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proyektor PJ-01"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#242044"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="30 September 2026"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proses"
                    android:textSize="11sp"
                    android:textColor="#6254D9"
                    android:padding="8dp"
                    android:background="#EFEDFF"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginTop="10dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🪑"
                    android:textSize="22sp"
                    android:background="#EFEDFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kursi Ruang A203"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#242044"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="28 September 2026"
                        android:textSize="11sp"
                        android:textColor="#777777"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selesai"
                    android:textSize="11sp"
                    android:textColor="#28A745"
                    android:padding="8dp"
                    android:background="#E8F7EC"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>